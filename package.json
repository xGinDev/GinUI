{
  "name": "@ginui/ginui",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "GinUI — Beautiful components for React Native Expo.",
  "packageManager": "yarn@3.6.1",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./button": "./dist/components/button.js",
    "./input": "./dist/components/input.js",
    "./card": "./dist/components/card.js"
  },
  "bin": "./dist/cli/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc -w"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-native": "^0.79.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "@types/react-native": "^0.73.0",
    "typescript": "^5.4.5"
  },
  "keywords": [
    "react-native",
    "expo",
    "components",
    "ui",
    "design-system",
    "react-native-ui"
